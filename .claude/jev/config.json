{
  "schema_version": 2,
  "jev_model": "jev-1.13.0",
  "main_tier": null,
  "auto_load_skills": [],
  "sensitive_handling": "skip",
  "max_prompt_chars": 20000,
  "max_diff_chars": 60000,
  "request_timeout_seconds": 12,
  "git_timeout_seconds": 15,
  "model_tracking_max_age_seconds": 86400,
  "log_retention_days": 7,
  "downgrade_min_confidence": 0.6,
  "downgrade_min_probability": 0.7,
  "exclude_globs": [
    ".env",
    ".env.*",
    "*.pem",
    "*.key",
    "*.p12",
    "*.pfx",
    "*.keystore",
    "id_rsa*",
    "id_ed25519*",
    "credentials*",
    "*secret*",
    ".npmrc",
    ".pypirc",
    ".netrc",
    ".git/**",
    ".aws/**",
    ".ssh/**",
    ".kube/**",
    ".claude/settings*.json",
    ".claude/jev/state",
    ".claude/jev/config.json",
    ".claude/jev/last-decision.json",
    ".claude/jev/.runtime/**"
  ]
}
